<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gurdy_policy</name>
  <version>0.1.0</version>
  <description>RL policy node: /cmd_vel + IMU + joint states -> ONNX policy (50 Hz) -> joint targets (gurdy_core.policy_runtime).</description>
  <maintainer email="noreply@example.com">S. Mahadev</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- onnxruntime has no rosdep key: pip-installed in docker/ros/Dockerfile -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
