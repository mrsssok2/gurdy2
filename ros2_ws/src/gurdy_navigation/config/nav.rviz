Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - {Class: rviz_default_plugins/Grid, Name: Grid, Enabled: true}
    - {Class: rviz_default_plugins/TF, Name: TF, Enabled: true}
    - {Class: rviz_default_plugins/RobotModel, Name: RobotModel, Enabled: true, Description Topic: {Value: /robot_description}}
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic: {Value: /map, Durability Policy: Transient Local}
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic: {Value: /scan, Reliability Policy: Best Effort}
      Size (m): 0.03
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Topic: {Value: /plan}
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic: {Value: /local_costmap/costmap}
      Alpha: 0.5
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: {Value: /initialpose}
    - Class: rviz_default_plugins/SetGoal
      Topic: {Value: /goal_pose}
  Value: true
