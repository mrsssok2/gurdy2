<?xml version="1.0"?>
<!-- Gazebo (Harmonic) + ros2_control additions. Included only when sim_gazebo:=true.
     Effort command interface + JointPDController (gurdy_control) = same PD law as MuJoCo. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="init" value="${'$(arg initial_q)'.split()}"/>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="ctrl_joint" params="leg type idx">
      <joint name="${leg}_${type}">
        <command_interface name="effort">
          <param name="min">${-jc['effort']}</param>
          <param name="max">${jc['effort']}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${init[idx] if len(init) == 3 else 0.0}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:macro name="ctrl_leg" params="leg">
      <xacro:ctrl_joint leg="${leg}" type="hip_yaw" idx="0"/>
      <xacro:ctrl_joint leg="${leg}" type="hip_pitch" idx="1"/>
      <xacro:ctrl_joint leg="${leg}" type="knee" idx="2"/>
    </xacro:macro>
    <xacro:ctrl_leg leg="lf"/>
    <xacro:ctrl_leg leg="lm"/>
    <xacro:ctrl_leg leg="lr"/>
    <xacro:ctrl_leg leg="rf"/>
    <xacro:ctrl_leg leg="rm"/>
    <xacro:ctrl_leg leg="rr"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_yaml)</parameters>
    </plugin>
  </gazebo>

  <!-- Foot friction (DART reads the ODE friction block). -->
  <xacro:macro name="foot_friction" params="leg">
    <gazebo reference="${leg}_tibia">
      <mu1>${cfg['legs']['foot']['friction']}</mu1>
      <mu2>${cfg['legs']['foot']['friction']}</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:foot_friction leg="lf"/>
  <xacro:foot_friction leg="lm"/>
  <xacro:foot_friction leg="lr"/>
  <xacro:foot_friction leg="rf"/>
  <xacro:foot_friction leg="rm"/>
  <xacro:foot_friction leg="rr"/>

  <!-- ============================ sensors (values from robot.yaml) ============================ -->
  <!-- gpu_lidar needs the Sensors system (ogre2) too, even with sensors:=false -->
  <xacro:if value="${'$(arg lidar)' == 'true' and '$(arg sensors)' != 'true'}">
    <gazebo>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </gazebo>
  </xacro:if>
  <xacro:if value="$(arg lidar)">
    <xacro:property name="ld" value="${cfg['sensors']['lidar']}"/>
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_link</gz_frame_id>
        <topic>/scan</topic>
        <update_rate>${ld['rate_hz']}</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan>
            <horizontal>
              <samples>${ld['rays']}</samples>
              <resolution>1</resolution>
              <min_angle>${-ld['fov'] / 2}</min_angle>
              <max_angle>${ld['fov'] / 2}</max_angle>
            </horizontal>
            <vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>${ld['range'][0]}</min><max>${ld['range'][1]}</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>${ld['noise']}</stddev></noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg sensors)">
    <!-- Sensor systems are loaded with the robot, so sensors:=false means no rendering at all
         (the render engine in the world file cost ~60 % RTF even without cameras). -->
    <gazebo>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    </gazebo>
    <xacro:property name="imu" value="${cfg['sensors']['imu']}"/>
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <topic>/imu</topic>
        <update_rate>${imu['rate_hz']}</update_rate>
        <always_on>true</always_on>
        <imu>
          <xacro:property name="gn" value="${imu['gyro_noise']}"/>
          <xacro:property name="an" value="${imu['accel_noise']}"/>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>${gn}</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>${gn}</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>${gn}</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>${an}</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>${an}</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>${an}</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <xacro:property name="cam" value="${cfg['sensors']['depth_camera']}"/>
    <gazebo reference="camera_link">
      <sensor name="depth_camera" type="rgbd_camera">
        <!-- gz cameras look along +x of camera_link; ROS image frame = optical frame -->
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <topic>/camera</topic>   <!-- -> /camera/image, /camera/depth_image, /camera/points, /camera/camera_info -->
        <update_rate>${cam['rate_hz']}</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>${cam['hfov']}</horizontal_fov>
          <image><width>${cam['width']}</width><height>${cam['height']}</height><format>R8G8B8</format></image>
          <clip><near>${cam['range'][0]}</near><far>${cam['range'][1]}</far></clip>
          <depth_camera><clip><near>${cam['range'][0]}</near><far>${cam['range'][1]}</far></clip></depth_camera>
        </camera>
      </sensor>
    </gazebo>

  </xacro:if>

  <!-- Ground-truth odometry for MEASURING (velocity tracking). No TF: Nav2 will use real odometry. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
      <odom_topic>/model/gurdy/odometry</odom_topic>
      <tf_topic>/model/gurdy/odometry/tf</tf_topic>
    </plugin>
  </gazebo>

  <!-- fixed_base:=true bolts base_link to the world (legs hang free) for step-response tests. -->
  <xacro:if value="$(arg fixed_base)">
    <link name="world"/>
    <joint name="world_fixed" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin xyz="0 0 $(arg base_z)"/>
    </joint>
  </xacro:if>
</robot>
