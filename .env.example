# Variable NAMES only. Never put real secret values in this file or any committed file.
# Export real values in your shell (or a local, git-ignored .env).

# Phase 4 voice (Gnani Prisma STT / Timbre TTS)
GNANI_API_KEY=

# Optional overrides used by compose.yaml (defaults shown in comments)
ROS_DOMAIN_ID=            # 42
ROS_DISCOVERY_RANGE=      # LOCALHOST (SUBNET when containers must talk to each other)
GZ_GALLIUM_DRIVER=        # d3d12 (llvmpipe = CPU rendering fallback)
GPU_ADAPTER=              # NVIDIA (d3d12 adapter name)
